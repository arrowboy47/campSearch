# Copy to .env next to docker-compose.yml, chmod 600. Never commit the real one.
#
# Note the host: inside the compose network the database is reached at
# campsearch-pg:5432, not the 127.0.0.1:5434 tunnel a laptop uses.
CAMPSEARCH_DATABASE_URL=postgresql://campsearch:CHANGEME@campsearch-pg:5432/camping
CAMPSEARCH_OPENWEATHER_API_KEY=
CAMPSEARCH_RIDB_API_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
CAMPSEARCH_SECRET_KEY=
