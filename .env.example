# Copy to .env and fill in. .env is gitignored.

# Postgres. Local dev against a throwaway container, or prod against the
# campsearch-pg container on thebigbox reached over an SSH tunnel:
#   ssh -L 5434:localhost:5434 thebigbox
DATABASE_URL=postgresql://campsearch:CHANGEME@localhost:5434/camping

# OpenWeather One Call 3.0 (day_summary). Rotate the old leaked key.
OPENWEATHER_API_KEY=

# Recreation.gov RIDB API key (https://ridb.recreation.gov/profile)
RIDB_API_KEY=

# Flask session signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
